---
// The parallax backdrop: sky, distant skyline and the two brick wings that
// flank the central bay. The wings are one SVG assembled in the browser from
// painted assets (brick tile, roofline cap, window unit, base strip; see
// scripts/facade-assets.mjs) so that whole storeys of windows are distributed
// over whatever height the page happens to have.
---

<div class="sky" aria-hidden="true" transition:persist></div>
<div class="skyline" aria-hidden="true" transition:persist></div>
<div class="wings" aria-hidden="true" transition:persist></div>

<script is:inline>
  (() => {
    const wings = document.querySelector(".wings");
    const cs = getComputedStyle(document.documentElement);
    const url = (v) =>
      cs
        .getPropertyValue(v)
        .trim()
        .replace(/^url\(["']?/, "")
        .replace(/["']?\)$/, "");
    const px = (v, d) => parseFloat(cs.getPropertyValue(v)) || d;
    const BRICK = url("--brick");
    const CAP = url("--cap");
    const WIN = url("--win");
    const BASE = url("--base");
    // Asset display sizes come from facade-sizes.css, generated by the
    // asset pipeline. One brick course is COURSE px everywhere.
    const CANAL = px("--canal", 140);
    const BAY_W = px("--bay-w", 840);
    const COURSE = px("--course", 9);
    const TILE_W = px("--brick-w", 152);
    const TILE_H = px("--brick-h", 144);
    const CAP_W = px("--cap-w", 346.7);
    const CAP_H = px("--cap-h", 133.5);
    const INSET = 20; // brick and parapet stop this short of the corner
    const WIN_W = px("--window-w", 104);
    const WIN_H = px("--window-h", 289.3);
    const BASE_W = px("--base-w", 403.7);
    const BASE_H = px("--base-h", 77.5);
    const EDGE_W = px("--edge-w", 32);
    const EDGE_H = px("--edge-h", 237.6);
    const EDGE = url("--edge");
    const COPING = px("--cap-coping", 56);
    // Design constants
    const CAP_Y = 36; // sky shows above the parapet
    const STOREY = 780; // vertical pitch between window rows

    // Deterministic PRNG so a given slot always gets the same decision.
    const rnd = (seed) => () => {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    const wallTop = CAP_Y + CAP_H; // the cap ends on a course; brick continues
    const rowTop = 210; // first window row, below the parapet

    // The height-independent part of one wing, drawn with its inner edge
    // (next to the bay) at x = 0. layout() sets everything that depends on
    // the page height, so a change of height never rebuilds the images.
    const wingMarkup = (W, tag) =>
      `<g id="w${tag}">` +
      // The brick stops short of the corner so its cut ends hide under the
      // quoins, whose shorter blocks are set back a little.
      // The brick and parapet stop short of the corner, under the quoins,
      // which project beyond them like a corner pilaster. In the quoin
      // column the parapet is clipped to its coping line so no raised step
      // shows above the stone.
      `<rect class="wall" y="${wallTop}" width="${W - INSET}" fill="url(#brick)"/>` +
      `<rect y="${CAP_Y}" width="${W - INSET}" height="${CAP_H}" fill="url(#cap)" clip-path="url(#corner${tag})"/>` +
      // Base strip, then the quay pavement in front of the recessed wing,
      // seen from above. The page's canal (whose quay edge is the pavement's
      // front edge) slides over it at the end of the scroll.
      `<g class="foot">` +
      `<rect width="${W - INSET}" height="${BASE_H}" fill="url(#base)" mask="url(#fadeUp)"/>` +
      `<rect y="${BASE_H}" width="${W}" height="${CANAL}" fill="url(#quay)"/>` +
      `<rect y="${BASE_H}" width="${W}" height="${CANAL}" fill="url(#joints)"/>` +
      `</g>` +
      // Sandstone quoins down the building's outer edge, over the brick and
      // plinth, down to the pavement.
      `<rect class="edge" x="${W - EDGE_W}" y="${CAP_Y + COPING}" width="${EDGE_W}" fill="url(#edge${tag})"/>` +
      `</g>` +
      // Night tint and the shadow cast by the bay, clipped to the wall's
      // silhouette (the parapet has sky between its steps). The mask repeats
      // the silhouette with plain shapes: Chrome mis-renders a mask whose
      // content is a <use> of a group containing masked elements.
      `<mask id="m${tag}" maskUnits="userSpaceOnUse" x="0" y="0" width="${W}">` +
      `<rect class="wall" y="${wallTop}" width="${W}" fill="#fff"/>` +
      `<rect y="${CAP_Y}" width="${W - EDGE_W}" height="${CAP_H}" fill="url(#capAlpha)"/>` +
      `<rect x="${W - EDGE_W}" y="${CAP_Y + COPING}" width="${EDGE_W}" height="${CAP_H - COPING}" fill="#fff"/>` +
      `<rect class="foot" width="${W}" height="${BASE_H + CANAL}" fill="#fff"/>` +
      `</mask>` +
      `<rect class="tall" width="${W}" fill="var(--brick-tint)" mask="url(#m${tag})"/>` +
      `<rect class="tall" width="${W}" fill="url(#shade)" mask="url(#m${tag})"/>` +
      `<g class="rows"></g>`;

    // One row of windows. Each slot is filled (or not), nudged, and lit by
    // a seeded random draw, so the two wings differ and the facade is not
    // symmetric. Rows sit on a fixed pitch from the top, so the rows above
    // the fold are in the same place on every page.
    const rowMarkup = (W, tag, i) => {
      let s = `<g class="row">`;
      const wingSeed = tag === "L" ? 101 : 202;
      // One column of windows, centred in the wing.
      if (W >= WIN_W + 48) {
        const r = rnd(wingSeed + i * 31);
        const present = (tag === "L" && i === 0) || r() < 0.6;
        const y = Math.round(rowTop + i * STOREY + (r() - 0.5) * 160);
        const x = Math.round((W - WIN_W) / 2 + (r() - 0.5) * 24);
        const lit = (0.15 + r() * 0.85).toFixed(2);
        if (present) {
          s += `<ellipse class="glow" style="--lit:${lit}" cx="${x + WIN_W / 2}" cy="${y + WIN_H / 2}" rx="${WIN_W * 1.6}" ry="${WIN_H * 0.8}" fill="url(#glow)"/>`;
          s += `<image class="win" style="--lit:${lit}" href="${WIN}" x="${x}" y="${y}" width="${WIN_W}" height="${WIN_H}"/>`;
        }
      }
      return s + `</g>`;
    };

    let svg = null;
    let builtW = 0;
    let lastH = 0;

    function layout(W, H) {
      svg.setAttribute("width", W);
      svg.setAttribute("height", H);
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      const bottom = H - CANAL - BASE_H - 24;
      const nRows = Math.max(
        0,
        Math.floor((bottom - rowTop - WIN_H - 80) / STOREY) + 1,
      );
      for (const g of svg.querySelectorAll(".wing")) {
        for (const r of g.querySelectorAll(".wall"))
          r.setAttribute("height", H - wallTop);
        for (const f of g.querySelectorAll(".foot"))
          f.setAttribute("transform", `translate(0 ${H - CANAL - BASE_H})`);
        g.querySelector(".edge").setAttribute(
          "height",
          H - CANAL - CAP_Y - COPING,
        );
        g.querySelector("mask").setAttribute("height", H);
        for (const r of g.querySelectorAll(".tall"))
          r.setAttribute("height", H);
        const rows = g.querySelector(".rows");
        while (rows.children.length > nRows) rows.lastElementChild.remove();
        for (let i = rows.children.length; i < nRows; i++)
          rows.insertAdjacentHTML(
            "beforeend",
            rowMarkup(builtW, g.dataset.tag, i),
          );
      }
    }

    function build() {
      const W = Math.round(wings.clientWidth);
      const H = Math.round(wings.clientHeight);
      const wingW = Math.floor((W - Math.min(W, BAY_W)) / 2);
      if (wingW < 24 || H < 120) {
        wings.innerHTML = "";
        svg = null;
        return;
      }
      if (!svg || wingW !== builtW) {
        // Brick courses continue the cap's courses; the fade hides the bond.
        const patY = ((CAP_Y + CAP_H) % COURSE).toFixed(1);
        // A vertical mask that is opaque at `solid` and transparent at `clear`
        // (fractions of the masked box), whichever is higher up.
        const fade = (id, solid, clear) => {
          const stops =
            solid < clear
              ? `<stop offset="${solid}" stop-color="#fff"/><stop offset="${clear}" stop-color="#fff" stop-opacity="0"/>`
              : `<stop offset="${clear}" stop-color="#fff" stop-opacity="0"/><stop offset="${solid}" stop-color="#fff"/>`;
          return (
            `<linearGradient id="${id}g" x1="0" y1="0" x2="0" y2="1">${stops}</linearGradient>` +
            `<mask id="${id}" maskContentUnits="objectBoundingBox"><rect width="1" height="1" fill="url(#${id}g)"/></mask>`
          );
        };
        const image = (id, href, w, h, y) =>
          `<pattern id="${id}" width="${w}" height="${h}" y="${y}" patternUnits="userSpaceOnUse"><image href="${href}" width="${w}" height="${h}"/></pattern>`;
        wings.innerHTML =
          `<svg xmlns="http://www.w3.org/2000/svg"><defs>` +
          image("brick", BRICK, TILE_W, TILE_H, patY) +
          image("cap", CAP, CAP_W, CAP_H, CAP_Y) +
          image("capAlpha", CAP, CAP_W, CAP_H, CAP_Y) +
          `<pattern id="edgeL" x="${wingW - EDGE_W}" y="${CAP_Y + COPING}" width="${EDGE_W}" height="${EDGE_H}" patternUnits="userSpaceOnUse"><image href="${EDGE}" width="${EDGE_W}" height="${EDGE_H}"/></pattern>` +
          `<pattern id="edgeR" x="${wingW - EDGE_W}" y="${CAP_Y + COPING}" width="${EDGE_W}" height="${EDGE_H}" patternUnits="userSpaceOnUse"><image href="${EDGE}" width="${EDGE_W}" height="${EDGE_H}"/></pattern>` +
          `<clipPath id="cornerL"><rect width="${wingW - EDGE_W}" height="99999"/><rect x="${wingW - EDGE_W}" y="${CAP_Y + COPING}" width="${EDGE_W}" height="99999"/></clipPath>` +
          `<clipPath id="cornerR"><rect width="${wingW - EDGE_W}" height="99999"/><rect x="${wingW - EDGE_W}" y="${CAP_Y + COPING}" width="${EDGE_W}" height="99999"/></clipPath>` +
          image("base", BASE, BASE_W, BASE_H, 0) +
          fade("fadeUp", 0.35, 0) +
          `<linearGradient id="quay" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6f6350"/><stop offset=".06" stop-color="#a99c85"/><stop offset=".12" stop-color="#b8ac95"/><stop offset="1" stop-color="#c0b59e"/></linearGradient>` +
          `<pattern id="joints" width="46" height="11" patternUnits="userSpaceOnUse"><path d="M0 10.5H46M23 0V11" stroke="#000" stroke-opacity=".07"/></pattern>` +
          `<linearGradient id="shade" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#2a0f08" stop-opacity=".65"/><stop offset=".08" stop-color="#2a0f08" stop-opacity=".3"/><stop offset=".5" stop-color="#2a0f08" stop-opacity=".12"/><stop offset="1" stop-color="#2a0f08" stop-opacity=".08"/></linearGradient>` +
          `<radialGradient id="glow"><stop offset="0" stop-color="#ffb347" stop-opacity=".6"/><stop offset="1" stop-color="#ffb347" stop-opacity="0"/></radialGradient>` +
          `</defs>` +
          `<g class="wing" data-tag="L" transform="translate(${wingW} 0) scale(-1 1)">${wingMarkup(wingW, "L")}</g>` +
          `<g class="wing" data-tag="R" transform="translate(${W - wingW} 0)">${wingMarkup(wingW, "R")}</g>` +
          `</svg>`;
        svg = wings.firstElementChild;
        builtW = wingW;
        lastH = 0;
      }
      if (H !== lastH) layout(W, H);
      lastH = H;
      // How far the wings still have to travel at the top of the page; the
      // canal uses it to sink their reflection while they sit higher.
      const f =
        parseFloat(getComputedStyle(wings).getPropertyValue("--f")) || 0;
      document.documentElement.style.setProperty(
        "--wing-travel",
        `${(((H - innerHeight) * f) / (1 - f)).toFixed(1)}px`,
      );
    }

    // Built synchronously: requestAnimationFrame does not fire in background
    // tabs, and the wings must be right whenever the page is next seen.
    const observer = new ResizeObserver(build);
    const observe = () => {
      observer.disconnect();
      observer.observe(document.body);
      build();
    };
    observe();
    addEventListener("resize", build);
    addEventListener("load", build);
    // The client router replaces <body>; the persisted wings stay, but the
    // new page has a new height.
    document.addEventListener("astro:after-swap", observe);
    document.addEventListener("astro:page-load", build);
    // Background tabs get no resize notifications; catch up when shown.
    document.addEventListener("visibilitychange", build);

    // Parallax fallback for browsers without scroll-driven animations.
    if (
      !CSS.supports("animation-timeline: scroll()") &&
      !matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      const layers = [...document.querySelectorAll(".skyline, .wings")].map(
        (el) => [el, parseFloat(getComputedStyle(el).getPropertyValue("--f"))],
      );
      const canal = document.querySelector(".canal");
      const update = () => {
        for (const [el, f] of layers)
          el.style.transform = `translateY(${(scrollY * f).toFixed(1)}px)`;
        const max = document.scrollingElement.scrollHeight - innerHeight;
        canal.style.setProperty(
          "--reflect-shift",
          `${(max > 0 ? 1 - scrollY / max : 0).toFixed(3)}`,
        );
      };
      addEventListener("scroll", () => requestAnimationFrame(update), {
        passive: true,
      });
      update();
    }
  })();
</script>

<style is:global>
  .sky {
    position: fixed;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(
        ellipse 70% 45% at 50% -5%,
        var(--sky-glow),
        transparent 70%
      ),
      linear-gradient(var(--sky-top), var(--sky-bottom));
  }

  .skyline,
  .wings {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }
  /* The building has a maximum width; beyond it there is only sky. */
  .skyline,
  .wings {
    left: max(0px, calc((100% - var(--building-w)) / 2));
    right: max(0px, calc((100% - var(--building-w)) / 2));
  }

  /* Distant rooftops, seen above the wings' parapets. */
  .skyline {
    z-index: -2;
    --f: 0.4;
    background: var(--skyline) center -6px / var(--skyline-w) var(--skyline-h)
      repeat-x;
    opacity: 0.85;
    /* Fade out towards the building's edges rather than stopping dead. */
    -webkit-mask: linear-gradient(
      90deg,
      transparent,
      #000 160px,
      #000 calc(100% - 160px),
      transparent
    );
    mask: linear-gradient(
      90deg,
      transparent,
      #000 160px,
      #000 calc(100% - 160px),
      transparent
    );
  }
  .dark .skyline {
    filter: brightness(0.3) saturate(0.6);
    opacity: 1;
  }

  .wings {
    z-index: -1;
    --f: 0.15;
    overflow: hidden;
  }
  .wings svg {
    display: block;
  }
  .wings .glow {
    opacity: calc(var(--glass-glow) * var(--lit, 1));
  }
  .dark .wings .win {
    filter: brightness(calc(0.45 + var(--lit, 1) * 0.85))
      saturate(calc(0.8 + var(--lit, 1) * 0.4));
  }

  /* Parallax: each layer lags the page by factor --f. Height and travel are
     expressed purely in terms of the document height, so the layer's bottom
     lines up with the page bottom at full scroll and no measurement is
     needed. The layer always reaches the viewport bottom while scrolling. */
  @keyframes lag {
    to {
      transform: translateY(calc((100% - 100vh) * (var(--f) / (1 - var(--f)))));
    }
  }
  .skyline,
  .wings {
    height: calc((1 - var(--f)) * 100% + var(--f) * 100vh);
    will-change: transform;
  }
  /* Two rules with different selectors on purpose: the CSS minifier would
     otherwise fold animation-timeline into the animation shorthand, which
     browsers reject, silently disabling the parallax. */
  @supports (animation-timeline: scroll()) {
    .skyline,
    .wings {
      animation: lag linear both;
    }
    body .skyline,
    body .wings {
      animation-timeline: scroll(root);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .skyline,
    .wings {
      height: 100%;
      animation: none;
    }
  }
  @media (max-width: 900px) {
    .skyline,
    .wings {
      display: none;
    }
  }
</style>
