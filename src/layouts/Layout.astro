---
import "@styles/globals.css";
import Header from "../components/Header.astro";
import Facade from "../components/Facade.astro";
import { SEO } from "astro-seo";

export interface Props {
  title: string;
  customTitle?: boolean;
  description?: string;
  ogType?: string;
}

const {
  title,
  customTitle = false,
  description,
  ogType = "website",
} = Astro.props;
const fullTitle = customTitle ? title : `${title} ⌁ Ross Gardiner`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="The personal site of Ross Gardiner" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ross Gardiner's blog"
      href={new URL("feed.xml", Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={fullTitle}
      description={description}
      openGraph={{
        basic: {
          title: fullTitle,
          type: ogType,
          image: "",
        },
      }}
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
      }}
    />
    <script is:inline lang="javascript">
      document.documentElement.classList.toggle(
        "dark",
        location.hash === "#dark" ||
          (location.hash !== "#light" &&
            (localStorage.theme === "dark" ||
              (!("theme" in localStorage) &&
                window.matchMedia("(prefers-color-scheme: dark)").matches)))
      );
    </script>
  </head>
  <body>
    <Facade />
    <div class="bay">
      <Header />
      <main class="rooms">
        <slot />
      </main>
      <div class="plinth"></div>
    </div>
    <footer class="canal">
      <a href="https://github.com/rossng/rossng.github.io/blob/main/README.md"
        >&copy; Ross Gardiner</a
      >
    </footer>
    <script is:inline>
      // Preview aid: open /#y=800 to load the page scrolled to 800px.
      if (location.hash.startsWith("#y="))
        addEventListener("load", () => scrollTo(0, +location.hash.slice(3)));
    </script>
  </body>
</html>
