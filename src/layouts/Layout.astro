---
import "@styles/globals.css";
import Header from "../components/Header.astro";
import Facade from "../components/Facade.astro";
import { SEO } from "astro-seo";

export interface Props {
  title: string;
  customTitle?: boolean;
  description?: string;
  ogType?: string;
}

const {
  title,
  customTitle = false,
  description,
  ogType = "website",
} = Astro.props;
const fullTitle = customTitle ? title : `${title} ⌁ Ross Gardiner`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="The personal site of Ross Gardiner" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ross Gardiner's blog"
      href={new URL("feed.xml", Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="image" href="/facade/brick.webp" />
    <link rel="preload" as="image" href="/facade/cap.webp" />
    <link rel="preload" as="image" href="/facade/window.webp" />
    <SEO
      title={fullTitle}
      description={description}
      openGraph={{
        basic: {
          title: fullTitle,
          type: ogType,
          image: "",
        },
      }}
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
      }}
    />
    <script is:inline>
      document.documentElement.classList.toggle(
        "dark",
        localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            matchMedia("(prefers-color-scheme: dark)").matches)
      );
      addEventListener("click", (e) => {
        if (!e.target.closest("#lightswitch")) return;
        const dark = document.documentElement.classList.toggle("dark");
        localStorage.theme = dark ? "dark" : "light";
      });
    </script>
  </head>
  <body>
    <Facade />
    <div class="bay">
      <Header />
      <main class="rooms">
        <slot />
      </main>
      <div class="plinth"></div>
    </div>
    <footer class="canal">
      <a href="https://github.com/rossng/rossng.github.io/blob/main/README.md"
        >&copy; Ross Gardiner</a
      >
    </footer>
  </body>
</html>
