---
import "@styles/globals.css";
import Header from "../components/Header.astro";
import Facade from "../components/Facade.astro";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title: string;
  customTitle?: boolean;
  description?: string;
  ogType?: string;
}

const {
  title,
  customTitle = false,
  description,
  ogType = "website",
} = Astro.props;
const fullTitle = customTitle ? title : `${title} ⌁ Ross Gardiner`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={description ?? "The personal site of Ross Gardiner"}
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ross Gardiner's blog"
      href={new URL("feed.xml", Astro.site)}
    />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link rel="preload" as="image" href="/facade/brick.webp" />
    <link rel="preload" as="image" href="/facade/cap.webp" />
    <link rel="preload" as="image" href="/facade/window.webp" />
    <title>{fullTitle}</title>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    {description && <meta property="og:description" content={description} />}
    <script is:inline>
      const applyTheme = (root) =>
        root.classList.toggle(
          "dark",
          localStorage.theme === "dark" ||
            (!("theme" in localStorage) &&
              matchMedia("(prefers-color-scheme: dark)").matches)
        );
      applyTheme(document.documentElement);
      requestAnimationFrame(() =>
        requestAnimationFrame(() =>
          document.documentElement.classList.add("ready")
        )
      );
      // The client router replaces <html>'s attributes with the new page's.
      // Put the classes on the incoming document so they are never removed:
      // restoring them afterwards would let a style recalc see the page
      // without them, and the theme colours would then fade in from light.
      document.addEventListener("astro:before-swap", (e) => {
        const root = e.newDocument.documentElement;
        applyTheme(root);
        root.classList.add("ready");
      });
      addEventListener("click", (e) => {
        if (!e.target.closest("#lightswitch")) return;
        const dark = document.documentElement.classList.toggle("dark");
        localStorage.theme = dark ? "dark" : "light";
      });
    </script>
  </head>
  <body>
    <Facade />
    <div class="bay">
      <Header />
      <main class="rooms">
        <slot />
      </main>
      <div class="plinth"></div>
    </div>
    <footer class="canal">
      <a href="https://github.com/rossng/rossng.github.io/blob/main/README.md"
        >&copy; Ross Gardiner</a
      >
    </footer>
  </body>
</html>
